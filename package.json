{
	"name": "todo-electron",
	"productName": "Todo Electron",
	"version": "0.1.0",
	"private": true,
	"description": "Production-ready Electron + Next.js desktop application template",
	"author": "jorgeadev",
	"license": "MIT",
	"main": "electron/main.js",
	"type": "module",
	"packageManager": "pnpm@12.9.1",
	"engines": {
		"node": ">=24.0.0",
		"pnpm": ">=12"
	},
	"scripts": {
		"dev": "concurrently -k -n next,electron -c green,blue \"npm:dev:next\" \"wait-on http-get://localhost:3000 && electron .\"",
		"dev:next": "next dev --turbopack -p 3000",
		"dev:electron": "electron .",
		"build": "pnpm run build:next && pnpm run build:electron",
		"build:next": "next build --turbopack",
		"build:electron": "electron-builder --dir",
		"dist": "electron-builder",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"typecheck": "tsc --noEmit",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"precommit": "pnpm run format && pnpm run lint:fix && pnpm run typecheck"
	},
	"build": {
		"appId": "com.example.todoelectron",
		"productName": "Todo Electron",
		"asar": true,
		"files": [
			"electron/**/*",
			"out/**/*",
			"package.json"
		],
		"directories": {
			"buildResources": "build",
			"output": "dist"
		},
		"artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
		"win": {
			"target": [
				{
					"target": "nsis",
					"arch": [
						"x64"
					]
				}
			]
		},
		"nsis": {
			"oneClick": false,
			"allowToChangeInstallationDirectory": true
		},
		"mac": {
			"target": [
				"dmg"
			],
			"category": "public.app-category.productivity"
		},
		"linux": {
			"target": [
				"AppImage"
			],
			"category": "Utility"
		},
		"extraMetadata": {
			"main": "electron/main.js"
		}
	},
	"devDependencies": {
		"@tailwindcss/postcss": "4.3.3",
		"@types/node": "24.19.1",
		"@types/react": "19.3.0",
		"@types/react-dom": "19.3.0",
		"concurrently": "10.0.5",
		"electron": "44.5.1",
		"electron-builder": "26.15.3",
		"eslint": "9.39.5",
		"eslint-config-next": "16.3.8",
		"eslint-config-prettier": "10.1.8",
		"next": "16.3.8",
		"prettier": "3.9.9",
		"prettier-plugin-tailwindcss": "0.8.1",
		"react": "19.3.0",
		"react-dom": "19.3.0",
		"tailwindcss": "4.3.3",
		"typescript": "6.0.3",
		"wait-on": "9.5.1",
		"yaml": "2.9.1"
	}
}
